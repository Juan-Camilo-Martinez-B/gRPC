POSTGRES_USER=ptc
POSTGRES_PASSWORD=ptc_railway
POSTGRES_DB=ptc
DATABASE_URL=postgresql://ptc:ptc_railway@postgres:5432/ptc
DB_POOL_MAX=4

# Plan gratuito de Supabase: db.<ref>.supabase.co es solo IPv6.
# Desde una red IPv4 usa el pooler de sesión (puerto 5432, hace falta para LISTEN):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_POOL_MAX=2
